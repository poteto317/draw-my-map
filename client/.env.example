# イラスト生成（Cloudflare Workers AI）の認証情報。
# このファイルを .env.local にコピーして、値を設定する。.env.local はコミットしない。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 共有（Phase 37）— Google OAuth / Auth.js。値は .env.local のみ（リポジトリに書かない）。
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 共有（Phase 37）— Cloudflare D1 / R2。イラスト用 CLOUDFLARE_* とは別名・別資格情報にする。
CF_SHARE_ACCOUNT_ID=
CF_SHARE_API_TOKEN=
CF_SHARE_D1_DATABASE_ID=
CF_SHARE_R2_ACCESS_KEY_ID=
CF_SHARE_R2_SECRET_ACCESS_KEY=
CF_SHARE_R2_BUCKET=
CF_SHARE_R2_ENDPOINT=
# 閲覧トークンの keyed hash 用。空なら AUTH_SECRET を使う。
CF_SHARE_TOKEN_SECRET=
# 共有リンク URL の origin（優先）。無ければ AUTH_URL → NEXT_PUBLIC_APP_URL → リクエスト origin。
CF_SHARE_PUBLIC_ORIGIN=

# 共同編集（Phase 39）— Durable Object / 参加チケット。値は .env.local のみ（リポジトリに書かない）。
# チケット署名秘密。空なら AUTH_SECRET を使う。
CF_COLLAB_TICKET_SECRET=
# 発行する wsUrl の origin 正本（x-forwarded-host は使わない）。
CF_COLLAB_WS_ORIGIN=
# Cloudflare Workers 側の Durable Object バインディング名（Worker 設定と揃える）。
CF_COLLAB_DO_BINDING=
# Next → collab-worker 管理 API（seed/export/connections）用共有秘密。Worker の SERVICE_SECRET と同一。
CF_COLLAB_SERVICE_SECRET=

# AI 支援（枝の要約・重要度の提案。Phase 32）の設定。どちらか一方のキーがあれば使える。
# このファイルを .env.local にコピーして値を設定する。.env.local はコミットしない（L-028）。
# シェルで同じ名前の変数を export していると、.env.local より優先される。
# 手順: docs/setup/ai-assist-setup.md
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic か openai。空なら ANTHROPIC_API_KEY を優先し、無ければ OPENAI_API_KEY を使う。
# 指定した提供元のキーが無い・値が不正なときは、もう一方へ切り替えず AI 支援を無効にする。
AI_ASSIST_PROVIDER=
# モデル ID の上書き（空なら既定: claude-opus-5-5 / gpt-5）。上書きできるモデルの条件は setup 文書を参照。
AI_ASSIST_ANTHROPIC_MODEL=
AI_ASSIST_OPENAI_MODEL=
# AI 支援の API を受け付ける Host のホスト名を足す（カンマ区切り。ポートは書かなくてよい）。
# 既定は localhost・127.0.0.1・[::1] だけ。LAN の別端末から機械の IP で開く・別名で開くときだけ設定する（例: 192.168.1.10,mymac.local）。
AI_ASSIST_ALLOWED_HOSTS=
